pipeline {
    agent {
        kubernetes {
            yaml '''
apiVersion: v1
kind: Pod
metadata:
  labels:
    jenkins/jenkins-jenkins-agent: "true"
spec:
  serviceAccountName: cd-agent-sa
  containers:
  - name: shell
    image: alpine/k8s:1.28.2
    command:
    - cat
    tty: true
'''
        }
    }
    
    parameters {
        string(name: 'IMAGE_TAG', defaultValue: 'v1', description: 'The immutable image tag to deploy')
        string(name: 'NAMESPACE', defaultValue: 'devops-app', description: 'Target Kubernetes Namespace')
    }
    
    stages {
        stage('Checkout') {
            steps {
                echo 'Pulling Kubernetes manifests...'
                checkout scm
            }
        }
        
        stage('Input & Manifest Validation') {
            steps {
                echo "Validating Image Tag: ${params.IMAGE_TAG} and target namespace: ${params.NAMESPACE}..."
                sh """
                    if [ "${params.IMAGE_TAG}" = "latest" ]; then
                        echo "Error: 'latest' tag is forbidden for deployments."
                        exit 1
                    fi
                """
            }
        }
        
        stage('Deploy to Kubernetes') {
            steps {
                container('shell') {
                    echo "Deploying version ${params.IMAGE_TAG} to namespace ${params.NAMESPACE}..."
                    sh """
                        # Apply configurations, workloads, and services
                        kubectl apply -f k8s/
                        
                        # Update deployments to use the immutable image tag
                        kubectl set image deployment/backend backend=yahaligottlieb/devops-backend:${params.IMAGE_TAG} -n ${params.NAMESPACE}
                        kubectl set image deployment/frontend frontend=yahaligottlieb/devops-frontend:${params.IMAGE_TAG} -n ${params.NAMESPACE}
                        
                        sleep 5
                    """
                }
            }
        }
        
        stage('Verify Rollout') {
            steps {
                container('shell') {
                    echo 'Waiting for Rollout to finish successfully...'
                    sh """
                        kubectl rollout status deployment/backend -n ${params.NAMESPACE} --timeout=300s
                        kubectl rollout status deployment/frontend -n ${params.NAMESPACE} --timeout=300s
                    """
                }
            }
        }
        
        stage('Smoke Test & Monitoring Gate') {
            steps {
                container('shell') {
                    echo "Checking Pods and Services health..."
                    sh "kubectl get pods -n ${params.NAMESPACE}"
                    sh "kubectl get svc -n ${params.NAMESPACE}"

                    echo "Executing Post-Deploy Monitoring Gate..."
                    // Verify that the backend service metrics endpoint is reachable
                    sh "curl -s -f http://backend.${params.NAMESPACE}.svc.cluster.local:5001/metrics > /dev/null || (echo 'Backend metrics endpoint unreachable!' && exit 1)"
                    
                    // Verify target is UP in Prometheus
                    sh '''
                        echo "Verifying target status from Prometheus..."
                        TARGET_UP=$(curl -s "http://prometheus-stack-kube-prom-prometheus.monitoring.svc.cluster.local:9090/api/v1/query?query=up%7Bjob%3D%22backend%22%7D" | grep -o '"result":\\[\\]' || true)
                        
                        if [ "$TARGET_UP" = '"result":[]' ]; then
                            echo "Monitoring Gate Warning: Target backend not yet registered or DOWN in Prometheus."
                        else
                            echo "Monitoring Gate Passed: Target is UP and reporting metrics to Prometheus."
                        fi
                    '''
                }
            }
        }
    }
    
    post {
        success {
            echo "CD Deployment of version ${params.IMAGE_TAG} succeeded!"
        }
        failure {
            echo "Deployment failed! Check logs or run rollback via: kubectl rollout undo deployment/backend -n ${params.NAMESPACE}"
        }
    }
}