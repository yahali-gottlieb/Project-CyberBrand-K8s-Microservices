pipeline {
    agent {
        kubernetes {
            yaml '''
            apiVersion: v1
            kind: Pod
            spec:
              serviceAccountName: cd-agent-sa
              containers:
              - name: kubectl
                image: bitnami/kubectl:latest
                command: ['cat']
                tty: true
            '''
        }
    }
    
    parameters {
        string(name: 'IMAGE_TAG', defaultValue: 'v1', description: 'The immutable image tag to deploy')
        string(name: 'NAMESPACE', defaultValue: 'devops-app', description: 'Target Kubernetes Namespace')
    }
    
    stages {
        stage('Checkout') {
            steps {
                echo 'Pulling Kubernetes manifests...'
                checkout scm
            }
        }
        
        stage('Input & Manifest Validation') {
            steps {
                echo "Validating Image Tag: ${params.IMAGE_TAG} and target namespace: ${params.NAMESPACE}..."
                sh """
                    if [ "${params.IMAGE_TAG}" = "latest" ]; then
                        echo "Error: 'latest' tag is forbidden for deployments."
                        exit 1
                    fi
                """
            }
        }
        
        stage('Deploy to Kubernetes') {
            steps {
                container('kubectl') {
                    echo "Deploying version ${params.IMAGE_TAG} to namespace ${params.NAMESPACE}..."
                    sh '''
                        # Apply configurations, workloads, and services (excluding example files)
                        kubectl apply -f k8s/
                        
                        # Update deployments to use the immutable image tag
                        kubectl set image deployment/backend backend=yahaligottlieb/devops-backend:${IMAGE_TAG} -n ${NAMESPACE}
                        kubectl set image deployment/frontend frontend=yahaligottlieb/devops-frontend:${IMAGE_TAG} -n ${NAMESPACE}
                        
                        sleep 5
                    '''
                }
            }
        }
        
        stage('Verify Rollout') {
            steps {
                container('kubectl') {
                    echo 'Waiting for Rollout to finish successfully...'
                    sh '''
                        kubectl rollout status deployment/backend -n ${NAMESPACE} --timeout=300s
                        kubectl rollout status deployment/frontend -n ${NAMESPACE} --timeout=300s
                    '''
                }
            }
        }
        
        stage('Smoke Test') {
            steps {
                container('kubectl') {
                    echo 'Running smoke test against deployed services...'
                    sh '''
                        kubectl get pods -n ${NAMESPACE}
                        kubectl get svc -n ${NAMESPACE}
                    '''
                }
            }
        }
    }
    
    post {
        success {
            echo "CD Deployment of version ${params.IMAGE_TAG} succeeded!"
        }
        failure {
            echo "Deployment failed! Check logs or run rollback via: kubectl rollout undo deployment/backend -n ${params.NAMESPACE}"
        }
    }
}