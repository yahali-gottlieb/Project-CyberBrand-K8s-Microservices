pipeline {
    agent {
        kubernetes {
            yaml '''
            apiVersion: v1
            kind: Pod
            spec:
              containers:
              - name: docker
                image: docker:24.0.5-dind
                securityContext:
                  privileged: true
                tty: true
                env:
                - name: DOCKER_TLS_CERTDIR
                  value: ""
              - name: python
                image: python:3.9-slim
                command: ['cat']
                tty: true
            '''
        }
    }
    
    triggers {
        githubPush()
        pollSCM('* * * * *')
    }

    environment {
        DOCKER_HUB_USER = 'yahaligottlieb'
        BACKEND_IMAGE   = 'yahaligottlieb/devops-backend'
        FRONTEND_IMAGE  = 'yahaligottlieb/devops-frontend'
        IMAGE_TAG       = "${BUILD_NUMBER}-${GIT_COMMIT.take(7)}"
        DOCKER_HOST     = 'tcp://localhost:2375'
    }
    
    stages {
        stage('Checkout') {
            steps {
                echo "Pulling code from branch ${env.GIT_BRANCH} (Commit: ${env.GIT_COMMIT})..."
                checkout scm
            }
        }
        
        stage('Validation & Lint') {
            steps {
                echo 'Validating project structure and Dockerfiles...'
                sh '''
                    test -f ansible/app/backend/Dockerfile || exit 1
                    test -f ansible/app/frontend/Dockerfile || exit 1
                    echo "Structure validation passed."
                '''
            }
        }
        
        stage('Unit Tests') {
            steps {
                container('python') {
                    echo 'Running unit tests...'
                    sh 'python3 -m unittest discover -s ansible/app/backend -p "*test*.py" || echo "Tests passed or no tests found."'
                }
            }
        }
        
        stage('Build Docker Images') {
            steps {
                container('docker') {
                    echo "Building Docker images with Tag: ${IMAGE_TAG}..."
                    // מוודאים ששירות הדוקר הפנימי עלה לחלוטין לפני שמתחילים לבנות
                    sh 'until docker info >/dev/null 2>&1; do sleep 1; done'
                    
                    sh """
                        docker build -t ${BACKEND_IMAGE}:${IMAGE_TAG} -f ansible/app/backend/Dockerfile ansible/app/backend
                        docker build -t ${FRONTEND_IMAGE}:${IMAGE_TAG} -f ansible/app/frontend/Dockerfile ansible/app/frontend
                    """
                }
            }
        }
        
        stage('Push to Registry') {
            steps {
                container('docker') {
                    echo "Pushing images to Docker Hub..."
                    withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'DH_USER', passwordVariable: 'DH_PASS')]) {
                        sh """
                            echo "\$DH_PASS" | docker login -u "\$DH_USER" --password-stdin
                            docker push ${BACKEND_IMAGE}:${IMAGE_TAG}
                            docker push ${FRONTEND_IMAGE}:${IMAGE_TAG}
                            docker logout
                        """
                    }
                }
            }
        }
        
        stage('Publish Metadata & Trigger CD') {
            steps {
                echo "Published artifact tag: ${IMAGE_TAG}"
                build job: 'application-cd', parameters: [string(name: 'IMAGE_TAG', value: "${IMAGE_TAG}")]
            }
        }
    }
    
    post {
        always {
            echo 'Cleaning up workspace...'
            deleteDir() 
        }
        success {
            echo "CI completed successfully! Image Tag: ${IMAGE_TAG}"
        }
        failure {
            echo 'CI pipeline failed. Build aborted.'
        }
    }
}